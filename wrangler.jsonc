// Configuración de Cloudflare: la web es estática (carpeta out/ que genera "npm run build").
{
  "name": "aula-de-voz-inma-gomes",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Necesario para las vistas previas de los PR ("npx wrangler preview")
  "previews": {}
}
